# ChatLab 环境变量配置文件
# 注意：本文件已被 .gitignore 忽略，不会提交至版本库

# 是否启用语义分析 (1/true 为启用，0/false 为仅使用纯本地规则)
CHATLAB_SEMANTIC=1

# MiniMax API 配置 (如需使用 MiniMax-M3 进行语义增强分类与回复评估，请填入您的 API Key)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_BASE=https://api.minimaxi.com/v1
MINIMAX_TIMEOUT=60
